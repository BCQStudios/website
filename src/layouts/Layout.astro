---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'BCQStudios',
	description = 'BCQStudios prototypes software for teams that need a working product before they scale it.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
		<link rel="sitemap" href="/sitemap.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&display=swap" rel="stylesheet" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<a
			href="https://github.com/BCQStudios"
			target="_blank"
			rel="noreferrer"
			aria-label="BCQStudios on GitHub"
			class="fixed top-6 right-6 text-muted-foreground hover:text-foreground"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-5 w-5">
				<path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.28-.01-1.03-.02-2.02-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.66-.3-5.46-1.33-5.46-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.23 0 1.61-.01 2.91-.01 3.31 0 .32.21.7.82.58A12.01 12.01 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
			</svg>
		</a>
		<main class="mx-auto flex max-w-lg grow flex-col justify-center px-6 py-20">
			<img src="/logo.svg" alt="" width="96" height="96" class="h-24 w-24" />
			<slot />
		</main>
		<nav class="px-6 pb-2 text-center text-xs text-muted-foreground/60">
			<a href="/terms" class="underline underline-offset-4 hover:no-underline">terms</a>
			<span class="text-muted-foreground/40" aria-hidden="true"> / </span>
			<a href="/privacy" class="underline underline-offset-4 hover:no-underline">privacy</a>
		</nav>
		<footer class="px-6 pb-6 text-center text-xs text-muted-foreground/60">
			<a
				href="https://github.com/bennycallanan"
				target="_blank"
				rel="noreferrer"
				class="underline underline-offset-4 hover:no-underline"
			>Brendan Callanan</a> trading as BCQStudios
		</footer>
	</body>
</html>
