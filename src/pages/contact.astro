---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact · BCQStudios" description="How to reach BCQStudios.">
	<h1 class="mt-6 text-3xl font-bold tracking-tight">Contact.</h1>
	<h2 class="mt-12 text-sm text-muted-foreground">Email</h2>
	<p class="mt-4 leading-relaxed text-muted-foreground">
		<a
			href="mailto:questions@bcqstudios.com"
			class="text-foreground underline underline-offset-4 hover:no-underline"
		>questions@bcqstudios.com</a>
	</p>
	<p class="mt-4 leading-relaxed text-muted-foreground">
		That's the inbox for studio work and questions about this site. One address covers both. We
		currently don't provide phone support.
	</p>
	<h2 class="mt-12 text-sm text-muted-foreground">Work</h2>
	<p class="mt-4 leading-relaxed text-muted-foreground">
		If you have a brief, send it. We'll reply and take it from there.
	</p>
	<p class="mt-12 text-sm text-muted-foreground/60">Last updated 17 September 2026</p>
	<p class="mt-4">
		<a href="/" class="underline underline-offset-4 hover:no-underline">Back to the studio</a>
	</p>
</Layout>
