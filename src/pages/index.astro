---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<h1 class="mt-6 text-3xl font-bold tracking-tight">We prototype software.</h1>
	<p class="mt-4 leading-relaxed text-muted-foreground">
		A studio for teams that need something working before they commit to a larger build. Interfaces,
		services, and the first version you can put in front of people.
	</p>
	<ul class="mt-10 grid grid-cols-[auto_auto_1fr] gap-x-3 gap-y-4 text-sm">
		<li class="col-span-3 grid grid-cols-subgrid">
			<span>Prototype</span>
			<span class="text-muted-foreground/40" aria-hidden="true">/</span>
			<span class="text-muted-foreground">a product you can click through, not a deck.</span>
		</li>
		<li class="col-span-3 grid grid-cols-subgrid">
			<span>Systems</span>
			<span class="text-muted-foreground/40" aria-hidden="true">/</span>
			<span class="text-muted-foreground">the apis and data the prototype stands on.</span>
		</li>
		<li class="col-span-3 grid grid-cols-subgrid">
			<span>Handoff</span>
			<span class="text-muted-foreground/40" aria-hidden="true">/</span>
			<span class="text-muted-foreground">a clear next step, with us or in-house.</span>
		</li>
	</ul>
	<h2 class="mt-12 text-sm text-muted-foreground">Resources</h2>
	<a
		href="https://www.findhandle.com"
		target="_blank"
		rel="noreferrer"
		class="group mt-4 grid grid-cols-[auto_auto_1fr] items-center gap-x-3 text-sm"
	>
		<span class="flex items-center gap-2">
			<img src="/findhandle.svg" alt="" width="20" height="20" class="h-5 w-5" />
			<span class="underline-offset-4 group-hover:underline group-focus-visible:underline">FindHandle</span>
		</span>
		<span class="text-muted-foreground/40" aria-hidden="true">/</span>
		<span class="text-muted-foreground">find your available brand name.</span>
	</a>
	<p class="mt-12 text-sm text-muted-foreground/60">
		Start a conversation at <a
			href="mailto:questions@bcqstudios.com"
			class="text-foreground underline underline-offset-4 hover:no-underline"
		>questions@bcqstudios.com</a>
	</p>
</Layout>
