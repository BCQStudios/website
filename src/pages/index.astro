---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<h1 class="mt-6 text-3xl font-bold tracking-tight">We develop software.</h1>
	<p class="mt-4 leading-relaxed text-muted-foreground">
		A studio for client work and our own releases. Digital products and the systems that sit under
		them, built to ship and stay in service.
	</p>
	<ul class="mt-10 grid grid-cols-[auto_auto_1fr] gap-x-3 gap-y-4 text-sm">
		<li class="col-span-3 grid grid-cols-subgrid">
			<span>Client</span>
			<span class="text-muted-foreground/40" aria-hidden="true">/</span>
			<span class="text-muted-foreground">platforms and products built to a brief.</span>
		</li>
		<li class="col-span-3 grid grid-cols-subgrid">
			<span>Studio</span>
			<span class="text-muted-foreground/40" aria-hidden="true">/</span>
			<span class="text-muted-foreground">titles we own, operate, and keep shipping.</span>
		</li>
		<li class="col-span-3 grid grid-cols-subgrid">
			<span>Systems</span>
			<span class="text-muted-foreground/40" aria-hidden="true">/</span>
			<span class="text-muted-foreground">the services and data those products stand on.</span>
		</li>
	</ul>
	<h2 class="mt-12 text-sm text-muted-foreground">Resources</h2>
	<div class="mt-4 grid grid-cols-[auto_auto_1fr] gap-x-3 text-sm">
		<a
			href="https://www.findhandle.com"
			target="_blank"
			rel="noreferrer"
			class="flex items-center gap-2 underline-offset-4 hover:underline focus-visible:underline"
		>
			<img src="/findhandle.svg" alt="" width="20" height="20" class="h-5 w-5" />
			FindHandle
		</a>
		<span class="text-muted-foreground/40" aria-hidden="true">/</span>
		<span class="text-muted-foreground">
			find your available brand name. <a
				href="/findhandle"
				class="underline-offset-4 hover:underline focus-visible:underline"
			>(view case study)</a>
		</span>
	</div>
	<p class="mt-12 text-sm text-muted-foreground/60">
		Start a conversation at <a
			href="mailto:questions@bcqstudios.com"
			class="text-foreground underline underline-offset-4 hover:no-underline"
		>questions@bcqstudios.com</a>
	</p>
</Layout>
